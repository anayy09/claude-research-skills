# Normalize line endings: text is LF in the repo, checked out native on Windows.
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv  text eol=lf

# Binary assets — never touch these.
*.xlsx binary
*.png  binary
*.jpg  binary
*.pdf  binary
